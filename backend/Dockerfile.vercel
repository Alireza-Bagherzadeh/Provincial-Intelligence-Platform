FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gdal-bin \
    libgdal-dev \
    libgeos-dev \
    proj-bin \
    libproj-dev \
    libpq-dev \
    gcc \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml ./

RUN pip install --no-cache-dir uv

RUN uv sync --no-dev

COPY . .

ENV PATH="/app/.venv/bin:$PATH"

RUN DJANGO_SECRET_KEY=build-only-secret \
    DJANGO_DEBUG=false \
    python manage.py collectstatic --noinput

# Fail the build immediately if gunicorn is not really present
RUN test -x /app/.venv/bin/gunicorn && \
    /app/.venv/bin/gunicorn --version

CMD ["sh", "-c", "exec /app/.venv/bin/gunicorn config.wsgi:application --bind 0.0.0.0:${PORT:-80}"]